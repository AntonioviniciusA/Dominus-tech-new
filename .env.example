# ============================================
# DOMINUS TECH - Environment Variables Example
# ============================================
# Copie este arquivo para .env.local e preencha com seus valores reais
# Não commit este arquivo com valores sensíveis

# ============================================
# NODE ENVIRONMENT
# ============================================
NODE_ENV=development

# ============================================
# DATABASE CONFIGURATION (Turso)
# ============================================
# URL do banco de dados Turso
TURSO_DATABASE_URL=libsql://your-database-name-your-org.turso.io

# Token de autenticação do Turso
TURSO_AUTH_TOKEN=eyJhbGciOiJFZFNTQSIsInR5cCI6IkpXVCJ9...

# ============================================
# ADMIN AUTHENTICATION
# ============================================
# Chave secreta para geração de JWT (mude em produção!)
ADMIN_SECRET_KEY=your-secret-key-change-in-production

# Credenciais padrão do admin (usadas na primeira execução)
ADMIN_DEFAULT_EMAIL=admin@dominustech.com
ADMIN_DEFAULT_PASSWORD=admin123

# ============================================
# PUBLIC VARIABLES (Expostas no frontend)
# ============================================
# URL da aplicação (usada em links de reset de senha)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Número do WhatsApp (com país e DDD, sem símbolos)
# Formato: 55 + DDD + 9 + número (ex: 556184497981)
NEXT_PUBLIC_WHATSAPP_NUMBER=556184497981

# URL do Instagram
NEXT_PUBLIC_INSTAGRAM_URL=https://instagram.com/dominustech

# ============================================
# ANALYTICS (Opcional)
# ============================================
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# ============================================
# NF-e CONFIGURATION (NFewizard)
# ============================================
# Caminho do certificado digital A1 (.pfx)
NFEW_CERT_PATH=/path/to/certificate.pfx

# Senha do certificado digital
NFEW_CERT_PASSWORD=certificate-password

# CNPJ da empresa (para emissão de NF-e)
NFEW_CNPJ=00000000000000

# UF de origem (ex: SP, RJ, MG, BA, etc)
NFEW_UF=SP

# Código de UF para NCM (ex: 35 para SP)
NFEW_UF_CODE=35

# Razão social da empresa
NFEW_RAZAO_SOCIAL=Dominus Tech LTDA

# Nome fantasia da empresa
NFEW_NOME_FANTASIA=Dominus Tech

# Dados do endereço da empresa
NFEW_ENDERECO_RUA=Rua Example
NFEW_ENDERECO_NUMERO=123
NFEW_ENDERECO_BAIRRO=Centro
NFEW_CEP=01310100
NFEW_MUNICIPIO=São Paulo
NFEW_COD_MUN=3550308

# Inscrição Estadual
NFEW_IE=0

# CSC (Código de Segurança do Contribuinte) - obtido na SEFAZ
NFEW_CSC_ID=1
NFEW_CSC_TOKEN=00000000-0000-0000-0000-000000000000

# Ambiente de emissão (1 = Homologação/Teste, 2 = Produção)
NFEW_AMBIENTE=2
